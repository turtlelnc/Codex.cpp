# Dedicated service; do not replace the host's administrative SSH configuration.
Port 2222
HostKey /etc/codex-server/ssh_host_ed25519_key
PidFile /run/codex-server/sshd.pid
UsePAM yes
PermitRootLogin no
PubkeyAuthentication yes
AuthenticationMethods publickey
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
AllowGroups codex-remote
AuthorizedKeysFile /etc/codex-server/keys/%u
StrictModes yes
PermitUserEnvironment no
PermitUserRC no
PermitTTY yes
DisableForwarding yes
X11Forwarding no
PermitTunnel no
ForceCommand /usr/local/libexec/codex-remote-gateway
MaxAuthTries 3
MaxSessions 4
MaxStartups 10:30:30
LoginGraceTime 30
ClientAliveInterval 30
ClientAliveCountMax 3
UseDNS no
LogLevel VERBOSE
