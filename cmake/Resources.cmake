# Binary-safe embedding, including MSVC (no oversized string literals).
set(resource_cpp "#include \"codex_resources.h\"\n")
set(resource_cases "")
function(codex_embed name filename)
  file(READ "${filename}" content HEX)
  string(REGEX REPLACE "(..)" "0x\\1," content "${content}")
  string(REPEAT "0x[0-9a-f][0-9a-f]," 16 row_pattern)
  string(REGEX REPLACE "(${row_pattern})" "\\1\n" content "${content}")
  string(MAKE_C_IDENTIFIER "${name}" identifier)
  string(APPEND resource_cpp "static const unsigned char ${identifier}[]={${content}};\n")
  string(APPEND resource_cases "if(name==\"${name}\")return {reinterpret_cast<const char*>(${identifier}),sizeof ${identifier}};\n")
  set(resource_cpp "${resource_cpp}" PARENT_SCOPE)
  set(resource_cases "${resource_cases}" PARENT_SCOPE)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${filename}")
endfunction()
foreach(asset index.html app.js style.css penguin.js)
  codex_embed("${asset}" "${CMAKE_CURRENT_SOURCE_DIR}/web/${asset}")
endforeach()
set(CODEX_BWRAP_EXECUTABLE "" CACHE FILEPATH "Optional native bubblewrap binary to embed in Linux releases")
if(CODEX_BWRAP_EXECUTABLE)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux")
    message(FATAL_ERROR "Embedded bubblewrap is Linux only")
  endif()
  codex_embed("bwrap" "${CODEX_BWRAP_EXECUTABLE}")
endif()
file(READ "${CMAKE_CURRENT_SOURCE_DIR}/docs/THIRD_PARTY_NOTICES.txt" notices)
file(READ "${codex_libgit2_SOURCE_DIR}/COPYING" git_license)
file(READ "${codex_curl_SOURCE_DIR}/COPYING" curl_license)
set(CODEX_EXTRA_LICENSE_FILES "" CACHE STRING "Additional license texts embedded by release builds")
set(extra_licenses "")
list(APPEND CODEX_EXTRA_LICENSE_FILES "${CMAKE_CURRENT_SOURCE_DIR}/docs/licenses/OpenSSL.txt" "${CMAKE_CURRENT_SOURCE_DIR}/docs/licenses/GCC-RUNTIME.txt"
  "${CMAKE_CURRENT_SOURCE_DIR}/docs/licenses/GPL3.txt" "${CMAKE_CURRENT_SOURCE_DIR}/docs/licenses/musl.txt" "${CMAKE_CURRENT_SOURCE_DIR}/docs/licenses/libcap.txt"
  "${codex_libgit2_SOURCE_DIR}/deps/zlib/LICENSE" "${codex_libgit2_SOURCE_DIR}/deps/pcre/COPYING" "${codex_libgit2_SOURCE_DIR}/deps/llhttp/LICENSE-MIT")
foreach(filename IN LISTS CODEX_EXTRA_LICENSE_FILES)
  file(READ "${filename}" license_text)
  string(APPEND extra_licenses "\n\n${filename}:\n${license_text}")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/third-party-notices.txt" "${notices}\n\nlibgit2:\n${git_license}\n\nlibcurl:\n${curl_license}\n${extra_licenses}")
codex_embed("licenses" "${CMAKE_CURRENT_BINARY_DIR}/third-party-notices.txt")
string(APPEND resource_cpp "std::string_view codex_resource(std::string_view name){\n${resource_cases}return {};\n}\n")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/codex_resources.cpp" "${resource_cpp}")
